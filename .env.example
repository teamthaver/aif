# MySQL 8.0.16+. Create it first: CREATE DATABASE aif_platform CHARACTER SET utf8mb4;
DATABASE_URL=mysql://aif:YourStrongPassword1@localhost:3306/aif_platform
# 32+ random characters (signs login cookies). node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_HOURS=8
INVITE_TTL_HOURS=48
# Exactly 32 bytes, base64 (encrypts PAN and bank account numbers). node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=SHXvBuyuDyCigmP1FK3xSknFWA5a5i8WD+/iLU1E4Dg=
# Sign-in codes. 'console' prints each code in the SERVER LOG (development only). Real delivery needs an email/SMS provider: see lib/notify.ts
OTP_DELIVERY=console
OTP_TTL_MINUTES=5
# Used by `npm run db:seed` to create the first system admin
SYSTEM_ADMIN_EMAIL=sysadmin@example.com
SYSTEM_ADMIN_PASSWORD=ChangeThisPassword!123
